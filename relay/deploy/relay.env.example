# Environment for the AllFather push relay (FCM, optional APNs).
# Copy to ~/.config/allfather-push-relay/relay.env and `chmod 600` it.
# systemd does not expand ~ or $HOME here: write absolute paths.

# Where phones reach the relay. Plain http:// is accepted only for a LAN or
# Tailscale address; anything public must be https://.
PUBLIC_URL=http://192.168.1.50:8787
# 0.0.0.0 so phones on the LAN can connect (default is 127.0.0.1 only).
HOST=0.0.0.0
PORT=8787
DATA_PATH=/home/YOUR_USER/.local/share/allfather-push-relay/relay.json

# Firebase service-account key (Project settings > Service accounts >
# Generate new private key). Keep it outside the checkout, chmod 600.
FCM_SERVICE_ACCOUNT=/home/YOUR_USER/.config/allfather-push-relay/service-account.json

# Optional: also serve iPhones. Set all four or none.
# APNS_KEY_PATH=/home/YOUR_USER/.config/allfather-push-relay/apns.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=

# Phones must prove they hold their push token (default: required).
RELAY_TOKEN_PROOF=required
# Set to 1 when a reverse proxy (Cloudflare Tunnel, Caddy…) sits in front.
# TRUST_PROXY=1
